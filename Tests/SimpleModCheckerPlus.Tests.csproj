<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>SimpleModCheckerPlus.Tests</AssemblyName>
    <RootNamespace>SimpleModCheckerPlus.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <ManagedPath
      Condition="'$(ManagedPath)' == ''"
    >$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</ManagedPath>
    <ManagedPath
      Condition="'$(ManagedPath)' == '' Or !Exists('$(ManagedPath)\Game.dll')"
    >C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</ManagedPath>
    <ManagedPath
      Condition="!Exists('$(ManagedPath)\Game.dll')"
    >C:\XboxGames\Cities- Skylines II - PC Edition\Content\Cities2_Data\Managed</ManagedPath>

    <ModAssembly>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net48\SimpleModCheckerPlus.dll</ModAssembly>
  </PropertyGroup>

  <Target Name="CheckInputs" BeforeTargets="BeforeBuild">
    <Error
      Condition="!Exists('$(ManagedPath)\Game.dll')"
      Text="Game assemblies not found. Set CSII_MANAGEDPATH, or pass -p:ManagedPath=..."
    />
    <Error
      Condition="!Exists('$(ModAssembly)')"
      Text="Build the mod first: the tests load $(ModAssembly)."
    />
  </Target>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedPath)\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
